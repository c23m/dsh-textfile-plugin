{
  "name": "dsh-textfile-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "在右侧栏查看并保存纯文本文件的 DSH 插件，由文件预览工具栏的编辑按钮进入。",
  "author": "c23m",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "text-file",
    "editor",
    "markdown",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c23m/dsh-textfile-plugin.git"
  },
  "homepage": "https://github.com/c23m/dsh-textfile-plugin#readme",
  "bugs": {
    "url": "https://github.com/c23m/dsh-textfile-plugin/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
